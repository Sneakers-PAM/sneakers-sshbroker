# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Ports and the WebSocket URL handed to the browser; see docs/configuration.md for the rest.
GRPC_PORT=9096
HTTP_PORT=9097
SSHBROKER_PUBLIC_WS_URL=ws://localhost:9097/ssh/session
VAULT_ADDR=localhost:9091
AUDIT_ADDR=localhost:9194
